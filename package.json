{
  "name": "pod-store-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema completo de gestao para loja de pods com estoque, vendas, fiados e financeiro.",
  "scripts": {
    "dev": "node server/dev.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "db:generate": "prisma generate",
    "db:push": "node prisma/init-db.js",
    "db:init": "node prisma/init-db.js",
    "db:seed": "node prisma/seed.js",
    "setup": "npm install && npm run db:generate && npm run db:push && npm run db:seed",
    "db:migrate": "prisma migrate deploy",
    "db:prepare": "prisma generate && prisma db push"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.545.0",
    "morgan": "^1.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "prisma": "6.12.0",
    "vite": "^7.1.7"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
